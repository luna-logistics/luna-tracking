# Cloudflare Workers static-assets response headers.

# ─── Site-wide security headers ─────────────────────────────────────────
# HSTS: tell every browser to only reach us over HTTPS for the next year
# and to apply the same rule to future subdomains. `preload` = eligible
# for the HSTS preload list (hstspreload.org) once we're confident no
# subdomain will ever need HTTP; the flag is safe to ship without
# actually submitting there. Redirect HTTP→HTTPS itself is handled by
# the "Always Use HTTPS" toggle at the Cloudflare zone level.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff

# ─── Private / auth surfaces — never indexed ────────────────────────────
# These are SPA routes served the home index.html as a fallback (no
# per-route noindex reaches a crawler before JS), so noindex is set at
# the HTTP layer keyed on the REQUEST path.

/admin
  X-Robots-Tag: noindex
/admin/*
  X-Robots-Tag: noindex
/compte
  X-Robots-Tag: noindex
/compte/*
  X-Robots-Tag: noindex
/en/account
  X-Robots-Tag: noindex
/en/account/*
  X-Robots-Tag: noindex
/connexion
  X-Robots-Tag: noindex
/inscription
  X-Robots-Tag: noindex
/en/login
  X-Robots-Tag: noindex
/en/signup
  X-Robots-Tag: noindex
/mot-de-passe-oublie
  X-Robots-Tag: noindex
/en/forgot-password
  X-Robots-Tag: noindex
/auth/*
  X-Robots-Tag: noindex

# ─── Long-lived caches for build output ─────────────────────────────
# Vite content-hashes everything under /assets/ (e.g. index-DRWrBeNO.js);
# the filename changes on any content change, so a year of `immutable`
# caching is safe and cuts the conditional-GET revalidation Cloudflare
# was doing on every visit (max-age=0, must-revalidate is the CF Pages
# default when no rule is set, and it dominates ~300 ms on repeat loads
# across the eager chunks). HTML is deliberately NOT covered here — it
# inherits the default so a new deploy is picked up immediately.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ─── Longer caches for stable public media ──────────────────────────
# Not content-hashed but rarely edited. 30 days fresh + 7 days
# stale-while-revalidate: the browser serves the cached copy instantly
# on a repeat visit, then refetches in the background. On an edit we
# still see the new file within a week without needing a rename.
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

/brand/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
