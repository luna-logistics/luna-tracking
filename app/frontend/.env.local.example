# Luna Tracking Logistics — local env
#
# 1. Create a NEW Supabase project (do NOT reuse the Homie Book project
#    poipjvzuaiyllyvopveu — this is a separate business + separate data).
# 2. Copy .env.local.example to .env.local and fill these in with values from
#    Supabase → Project Settings → API.
# 3. .env.local is git-ignored; only .env.local.example is committed.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
